# Backend only. Never prefix secrets with KIDSPLAY_PUBLIC_.
KIDSPLAY_ENV=development
KIDSPLAY_DB_HOST=127.0.0.1
KIDSPLAY_DB_PORT=3306
KIDSPLAY_DB_NAME=kidsplay_db
KIDSPLAY_DB_USER=
KIDSPLAY_DB_PASSWORD=
KIDSPLAY_DB_SSL=false
# Optional absolute path to the remote database CA certificate.
KIDSPLAY_DB_SSL_CA=
KIDSPLAY_COOKIE_SECURE=false
KIDSPLAY_CATALOG_ADMIN_PORT=8787
KIDSPLAY_API_HOST=127.0.0.1
KIDSPLAY_API_PORT=8788
# Comma-separated exact browser origins. Production requires HTTPS origins.
KIDSPLAY_ALLOWED_ORIGINS=http://localhost:8443,http://127.0.0.1:8443
# Optional Vite proxy target. Empty preserves the embedded local API.
KIDSPLAY_API_TARGET=
# Optional development default for KidsPlay Admin. Packaged apps use the OS environment or first-run settings.
KIDSPLAY_ADMIN_API_URL=
# Public, compiled into frontend. Empty uses same-origin /api (recommended).
# Set to the server origin only, e.g. http://localhost:8788, NOT ending in /api.
KIDSPLAY_PUBLIC_API_BASE_URL=

# Local bootstrap account. Use a unique email and a strong password; no
# default password is provided. The password is hashed before being stored.
KIDSPLAY_TEST_USER_NAME=KidsPlay Local
KIDSPLAY_TEST_USER_EMAIL=kidsplay.local@example.test
KIDSPLAY_TEST_USER_PASSWORD=

# Conta administradora do Controle (pnpm admin:create)
KIDSPLAY_ADMIN_NAME=Administrador
KIDSPLAY_ADMIN_EMAIL=
KIDSPLAY_ADMIN_PASSWORD=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kidsplay-media
R2_PUBLIC_URL=

# Origem publica das midias (URL r2.dev). Vazio = servir localmente
KIDSPLAY_MEDIA_BASE_URL=
