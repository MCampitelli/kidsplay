{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "electron/main.mjs",
  "scripts": {
    "predev": "node scripts/generate-shows.mjs",
    "prebuild": "node scripts/generate-shows.mjs",
    "encode-videos": "node video-processing/scripts/encode-videos.mjs",
    "test:media": "node --test video-processing/scripts/media-processing.test.mjs",
    "test:tags": "node --test api/catalogTags.test.mjs",
    "test:tags:integration": "pnpm build:api && node --test api/catalogTags.integration.test.mjs",
    "seed:local-user": "node scripts/seed-local-user.mjs",
    "catalog:admin": "node scripts/catalog-admin.mjs",
    "precatalog:admin": "pnpm build:api",
    "build:api": "tsc -p tsconfig.backend.json",
    "api:dev": "pnpm build:api && node build/backend/api/server.js",
    "api:start": "node build/backend/api/server.js",
    "db:migrate": "node scripts/migrate.mjs",
    "admin:role": "node scripts/admin-role.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "media:upload": "node scripts/upload-media-r2.mjs",
    "test": "node --test config/environment.test.mjs api/requestPolicy.test.mjs api/catalogTags.test.mjs video-processing/scripts/media-processing.test.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.backend.json --noEmit",
    "test:api:integration": "pnpm build:api && node --test api/backend.integration.test.mjs",
    "test:integration": "pnpm build:api && node --test api/backend.integration.test.mjs api/catalogTags.integration.test.mjs",
    "test:electron": "node --test electron/apiPolicy.test.mjs",
    "test:electron:integration": "node --test electron/api.integration.test.mjs",
    "electron:dev": "electron .",
    "electron:smoke": "electron . --smoke-test",
    "electron:pack:dir": "electron-builder --dir --win",
    "electron:build": "pnpm electron:smoke && electron-builder --win nsis",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "hls.js": "^1.7.3",
    "mariadb": "^3.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  },
  "build": {
    "appId": "com.kidsplay.admin",
    "productName": "KidsPlay Admin",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "catalog-admin/**/*",
      "config/environment.mjs",
      "package.json",
      "!node_modules/**/*",
      "!electron/**/*.test.mjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "KidsPlay-Admin-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
